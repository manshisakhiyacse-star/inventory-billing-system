# ========================
# Inventory & Billing Management System — Environment Variables
# ========================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to source control.
# ========================

# ---- Database ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=inventory_billing
DB_USERNAME=inv_app
DB_PASSWORD=CHANGE_ME_local_dev_password

# ---- JWT ----
# Must be at least 64 characters for HS256. Generate with:
#   openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_a_secure_random_string_at_least_64_chars_long
JWT_EXPIRATION_MS=3600000

# ---- Default Admin (used only by seed migration / first startup) ----
# Change this password immediately after first login.
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_admin_password

# ---- Spring Profile ----
SPRING_PROFILES_ACTIVE=local

# ---- Server ----
SERVER_PORT=8080

# ---- CORS (comma-separated origins) ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
